# Dev-time only. The peers below are supplied by the DSH host at runtime; the
# exact versions pinned in peerDependencies are shipped inside the DSH install
# and are NOT published to the public npm registry (verified 2026-11-11:
# npm view @deepseek-ai/dsh-tools@0.1.0-rc.5 -> E404). Never let pnpm try to
# fetch them from the registry: `scripts/link-dsh.mjs` junctions the installed
# copies instead, so the plugin and the host share module identity.
auto-install-peers=false
strict-peer-dependencies=false
resolution-mode=highest
