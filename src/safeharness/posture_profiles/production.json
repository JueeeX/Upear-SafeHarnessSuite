{
  "name": "production",
  "description": "与 hardened 同守卫姿态，并以 --strict 门禁启动：姿态校验出现任何 WARN/FAIL（含基线偏离）即拒绝启动五进程。通信网关配置对由启动器原生注入，基线仅作确认。",
  "env": {
    "SAFEHARNESS_MCP_POLICY_GUARD": "1",
    "SAFEHARNESS_MCP_DESCRIPTOR_ENFORCE": "1",
    "SAFEHARNESS_TOOL_GATEWAY_DESCRIPTOR_ENFORCE": "1",
    "SAFEHARNESS_EXTERNAL_OUTPUT_GUARD": "1",
    "SAFEHARNESS_EXTERNAL_OUTPUT_ENFORCE": "1",
    "SAFEHARNESS_AUDIT_REDACTION": "1",
    "SAFEHARNESS_INFORM_RULES_WATCH": "1"
  },
  "gateway_env": {},
  "secrets": {
    "SAFEHARNESS_DEMO_SIGNING_KEY": "demoSigningKey"
  },
  "expect": {
    "SAFEHARNESS_PROTECTED_CHAT_ENABLED": "OK",
    "SAFEHARNESS_MCP_POLICY_GUARD": "OK",
    "SAFEHARNESS_MCP_DESCRIPTOR_ENFORCE": "OK",
    "SAFEHARNESS_TOOL_GATEWAY_DESCRIPTOR_ENFORCE": "OK",
    "SAFEHARNESS_EXTERNAL_OUTPUT_GUARD": "OK",
    "SAFEHARNESS_EXTERNAL_OUTPUT_ENFORCE": "OK",
    "SAFEHARNESS_AUDIT_REDACTION": "OK",
    "SAFEHARNESS_INFORM_RULES_WATCH": "OK",
    "MEM0_ENABLED": "OK",
    "SAFEHARNESS_DEMO_SIGNING_KEY": "OK",
    "SAFEHARNESS_COMMUNICATION_GATEWAY_URL": "OK",
    "SAFEHARNESS_TOOL_GATEWAY_URL": "OK"
  },
  "strict": true,
  "gate": true,
  "report": true
}
